{
  "name": "selor-epso-prep",
  "private": true,
  "description": "Entraînement gratuit aux tests de raisonnement SELOR (Travaillerpour.be) et EPSO, en français et en néerlandais",
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i src/css/main.css -o assets/css/app.css --minify",
    "watch:css": "tailwindcss -i src/css/main.css -o assets/css/app.css --watch",
    "build": "npm run build:css && node scripts/build-site.js",
    "watch:site": "node scripts/build-site.js --watch",
    "start": "npm run build && http-server -c-1 -p 8000 dist",
    "calculer:numerique": "node scripts/calculer-numerique.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "http-server": "^14.1.1"
  }
}
